# KisanSetu Environment Variables Example Template
# Copy this file to .env or set these in your local environment.
# NEVER commit real passwords or production secrets to Git.

# Active Spring Profile: 'mysql' for local MySQL 9.4, 'h2' for in-memory development
SPRING_PROFILES_ACTIVE=mysql

# MySQL Server Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kisansetu
DB_USERNAME=kisan_app
DB_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# Security Secret (min 256-bit hex/base64 string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Platform Fee Percentage (Default 0.0)
PLATFORM_FEE_PERCENTAGE=0.0

# Optional Google Gemini AI API Key (Leave empty if not using AI market insights)
GEMINI_API_KEY=

# ─── Cloudinary (Frontend) Image Storage ─────────────────────────────────────
# Used for crop listing photos — upload from computer or phone camera.
# 1. Create account at https://cloudinary.com (free tier is sufficient)
# 2. Go to Settings → Upload → Add upload preset → set mode to "Unsigned"
# 3. Copy your Cloud Name from the Cloudinary dashboard
# Add these to frontend/.env (not this file — this file is backend-only)
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
# VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_here
